
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#193c70">
<meta name="description" content="SportMetric 全球体育导航平台">
<title>SportMetric - 全球体育导航</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#f5f2ea;color:#333;font-family:Arial,"Microsoft YaHei",sans-serif}
.container{max-width:680px;margin:auto;padding:15px}
header{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}
.logo{font-size:23px;font-weight:900;color:#193c70;letter-spacing:1px}
.logo span{color:#c5a15b}
.header-tag{font-size:12px;color:#888}
.search{display:flex;background:white;border-radius:30px;padding:5px;margin-bottom:17px}
.search input{flex:1;min-width:0;border:0;outline:0;padding:11px 14px;font-size:14px;background:transparent}
.search button{border:0;background:#193c70;color:white;border-radius:25px;padding:0 20px}
.hero{background:linear-gradient(135deg,#19345e,#315b91);border-radius:13px;padding:30px 15px;text-align:center;color:white;margin-bottom:15px}
.hero h1{margin:0 0 10px;font-size:29px;letter-spacing:2px}
.hero p{margin:0;color:#dce6f3;font-size:13px}
.line{width:48px;height:3px;background:#c5a15b;margin:15px auto 0}
.notice{background:white;border-radius:8px;padding:12px;font-size:12px;color:#876a34;margin-bottom:21px}
.section-title{display:flex;justify-content:space-between;align-items:center;margin:20px 2px 12px}
.section-title h2{font-size:17px;color:#725a32;margin:0}
.section-title span{font-size:11px;color:#888}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px}
.card{display:flex;flex-direction:column;align-items:center;justify-content:center;background:white;border-radius:11px;padding:17px 8px;min-height:116px;text-decoration:none;color:#333;box-shadow:0 2px 8px #00000008}
.card:active{transform:scale(.97)}
.icon{font-size:29px;margin-bottom:9px}
.card strong{font-size:14px;margin-bottom:6px}
.card small{font-size:11px;color:#888;text-align:center}
.enter{background:#c5a15b;color:white;padding:5px 25px;border-radius:20px;font-size:11px;margin-top:10px}
.tool-card{background:#202020;color:#c5a15b;border-radius:9px;padding:17px 10px;display:flex;align-items:center;gap:10px;text-decoration:none;font-size:13px;font-weight:bold;min-height:65px}
.tool-card span{font-size:23px}
.empty{display:none;text-align:center;padding:25px;color:#888;font-size:13px}
footer{text-align:center;padding:28px 10px 18px;color:#888;font-size:11px;line-height:2}
footer a{color:#193c70;text-decoration:none;margin:0 6px}
@media(min-width:600px){.container{padding:24px}.grid{gap:15px}}
</style>
</head>
